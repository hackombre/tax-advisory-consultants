# Copie ce fichier en ".env" et remplis les vraies valeurs (ne commite jamais le .env réel)

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Adresse Gmail complète qui ENVOIE l'e-mail (le compte utilisé pour se connecter au SMTP)
SMTP_USER=votre-adresse@gmail.com

# Mot de passe d'application Gmail à 16 caractères (PAS le mot de passe normal du compte)
# Voir le README pour la procédure de génération.
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Adresse qui REÇOIT les messages du formulaire (peut être la même que SMTP_USER)
CONTACT_RECIPIENT=contact@taxadvisoryconsultants.com

# Domaines autorisés à appeler l'API (séparés par une virgule)
CORS_ORIGINS=http://localhost:3000,https://taxadvisoryconsultants.com

# Adresse qui reçoit les alertes de sécurité (tentatives de connexion bloquées
# sur l'espace de gestion caché du site). Optionnel : par défaut CONTACT_RECIPIENT.
SECURITY_RECIPIENT=contact@taxadvisoryconsultants.com

# Secret partagé avec le site Next.js pour appeler /api/security-alert.
# Doit être identique à INTERNAL_API_SECRET dans front/.env.local
INTERNAL_API_SECRET=change-moi-en-une-longue-valeur-aleatoire
