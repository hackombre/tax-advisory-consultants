# Copie ce fichier en ".env.local" à la racine de /front

# URL du backend FastAPI
NEXT_PUBLIC_API_URL=http://localhost:8000

# Secret partagé avec le backend FastAPI pour appeler /api/security-alert
# (alerte e-mail après 5 tentatives de connexion échouées sur la page cachée).
# Doit être identique à INTERNAL_API_SECRET dans back/.env
INTERNAL_API_SECRET=change-moi-en-une-longue-valeur-aleatoire

# La traduction automatique FR -> EN (Google Translate) ne nécessite aucune
# clé ni configuration : elle se déclenche automatiquement la première fois
# qu'un visiteur consulte une publication en anglais, et le résultat est
# ensuite mis en cache sur la publication elle-même.
